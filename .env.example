# Observability Configuration Example
# Elasticsearch target indices
BACKEND_LOG_INDEX=backend-logs
API_TELEMETRY_INDEX=api-telemetry

# swagger-stats telemetry dashboard credentials
SWAGGER_STATS_USER=admin
SWAGGER_STATS_PASSWORD=admin123

# Elastic Cloud credentials
# Automatically inherited from services/frontend-log-collector/.env if not explicitly set here
# ELASTICSEARCH_URL=https://<deployment-name>.es.<region>.<provider>.elastic-cloud.com:9243
# ELASTIC_API_KEY=<base64_api_key>

# Grafana Cloud Prometheus remote_write credentials
# Loaded from D:/AILab/monitoring/.env or environment
# GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-XX.grafana.net/api/prom/push
# GRAFANA_CLOUD_PROMETHEUS_USERNAME=123456
# GRAFANA_CLOUD_PROMETHEUS_TOKEN=glc_eyJ...
